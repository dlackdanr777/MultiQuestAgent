<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.StoryWing.EnglishTown" />
        <package android:name="com.StoryWing.AlphabatApp" />
        <package android:name="com.StoryWing.Ocean_Adventure" />
        <package android:name="com.StoryWing.OceanAdventure" />
        <package android:name="com.StoryWing.Korea_History" />
        <package android:name="com.StoryWing.KoreaHistory2" />
        <package android:name="com.StoryWing.Solar_System" />
        <package android:name="com.StoryWing.SpaceApp" />
        <package android:name="com.StoryWing.Fire_Safety" />
        <package android:name="com.StoryWing.FirepreventionApp" />
        <package android:name="com.StoryWing.Jurassic" />
        <package android:name="com.StoryWing.BrainPop" />
        <package android:name="com.StoryWing.XR_BrainTraining" />
        <package android:name="com.StoryWing.SmartFarm" />
        <package android:name="com.StoryWing.GyeongjuMR" />
        <package android:name="com.StoryWing.Museum" />
        <package android:name="com.StoryWing.XR_Museum" />
        <package android:name="com.StoryWing.World_Travel" />
        <package android:name="com.StoryWing.XR_WorldMap" />
        <package android:name="com.StoryWing.OceanAdventure_ViewVer" />
        <package android:name="com.StoryWing.SpaceAppTest" />
        <package android:name="com.StoryWing.XR_Coding" />
        <package android:name="com.StoryWing.Storywing_Class" />
        <package android:name="com.StoryWing.StorywingClass" />

        <package android:name="com.StoryWing.App1" />
        <package android:name="com.StoryWing.App2" />
        <package android:name="com.StoryWing.App3" />
        <package android:name="com.StoryWing.App4" />
        <package android:name="com.StoryWing.App5" />
        <package android:name="com.StoryWing.App6" />
        <package android:name="com.StoryWing.App7" />
        <package android:name="com.StoryWing.App8" />
        <package android:name="com.StoryWing.App9" />
        <package android:name="com.StoryWing.App10" />
        <package android:name="com.StoryWing.App11" />
        <package android:name="com.StoryWing.App12" />
        <package android:name="com.StoryWing.App13" />
        <package android:name="com.StoryWing.App14" />
        <package android:name="com.StoryWing.App15" />
        <package android:name="com.StoryWing.App16" />
        <package android:name="com.StoryWing.App17" />
        <package android:name="com.StoryWing.App18" />
        <package android:name="com.StoryWing.App19" />
        <package android:name="com.StoryWing.App20" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 프로젝트에는 이 클래스 선언과 Kotlin 클래스가 각각 하나만 있어야 합니다. -->
        <activity
            android:name=".CapturePermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.MultiQuest.Transparent"
            android:launchMode="singleTask"
            android:taskAffinity="tdg.oculuswirelessadb.capture"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:finishOnTaskLaunch="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".KeepAwakeActivity"
            android:exported="false"
            android:theme="@style/Theme.MultiQuest.Transparent"
            android:launchMode="singleTask"
            android:taskAffinity="tdg.oculuswirelessadb.keepawake"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:finishOnTaskLaunch="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 종료 후 Library/Home 노출을 막는 조작 없는 검은 화면 -->
        <activity
            android:name=".IdleShieldActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:taskAffinity="tdg.oculuswirelessadb.idle"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:finishOnTaskLaunch="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".agent.AgentService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".capture.CaptureService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".agent.StoryWingAppStateReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="com.storywing.multiquest.APP_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>